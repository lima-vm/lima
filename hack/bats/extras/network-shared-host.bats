# Tests the "shared" and "host" networks, served by socket_vmnet on macOS and by
# lima-privileged-net on Linux. Requires the sudoers file generated by `limactl sudoers`
# for $LIMA_HOME, plus socket_vmnet on macOS or dnsmasq on Linux.
# "bridged" is not tested, as it needs a bridge that already exists on the host.

load "../helpers/load"

SHARED=bats-net-shared
HOST=bats-net-host
DOUBLE=bats-net-double
PLAIN1=bats-plain-1
PLAIN2=bats-plain-2

case "$(uname -s)" in
Darwin)
    VAR_RUN=/private/var/run/lima
    DAEMON=socket_vmnet
    ;;
Linux)
    VAR_RUN=/run/lima
    DAEMON=lima-privileged-net
    ;;
esac

# Runs a guest beside $PLAIN1 with the CPU, memory, disk and network arguments that Lima uses,
# but without a hostagent or cidata. It boots from a throwaway snapshot of $PLAIN1's disk, and
# console=ttyS0 puts the boot on the serial log, which shows that the guest ran.
start_bare_qemu_guest() {
    local instance=${LIMA_HOME}/${PLAIN1}
    local evidence=${HOME}/vmnet-evidence
    date -u >"${evidence}/bare-qemu.log"
    qemu-system-x86_64 -m 4096 -cpu host,-avx512vl,-pdpe1gb -machine q35,accel=hvf \
        -smp 4,sockets=1,cores=4,threads=1 \
        -drive if=pflash,format=raw,readonly=on,file=/usr/local/share/qemu/edk2-x86_64-code.fd \
        -drive "file=${instance}/disk,if=none,discard=on,id=boot-disk,snapshot=on,file.locking=off" \
        -device virtio-blk-pci,drive=boot-disk,bootindex=1 \
        -kernel "${instance}/kernel" -initrd "${instance}/initrd" \
        -append "root=LABEL=cloudimg-rootfs ro console=ttyS0 no_timer_check" \
        -netdev user,id=net0,net=192.168.5.0/24,dhcpstart=192.168.5.15 \
        -device virtio-net-pci,netdev=net0,mac=52:55:55:dd:37:e7 \
        -device virtio-rng-pci -display none -vga none -parallel none \
        -serial "file:${evidence}/bare-qemu-serial.log" \
        >>"${evidence}/bare-qemu.log" 2>&1 3>&- 4>&- &
    local pid=$!
    sleep 180
    # QEMU exiting early must fail setup_file, or a clean job would prove nothing.
    kill -0 "$pid"
    kill "$pid"
}

local_setup_file() {
    [[ -n ${DAEMON:-} ]] || skip "shared and host networks are only supported on macOS and Linux hosts"
    case ${NETWORK_ARM:-} in
    two-plain)
        ensure_instance "$PLAIN1"
        ensure_instance "$PLAIN2"
        ;;
    bare-qemu)
        ensure_instance "$PLAIN1"
        start_bare_qemu_guest
        ;;
    bare-qemu-delayed)
        ensure_instance "$PLAIN1"
        # The gap spans several evidence ticks, so a lost runner shows whether it died as
        # the first VM finished starting or as the second guest launched.
        date -u >"${HOME}/vmnet-evidence/first-vm-ready"
        sleep 120
        start_bare_qemu_guest
        ;;
    one-double)
        ensure_instance "$DOUBLE"
        # Fill guest memory, to stand in for what a second VM would hold on the host.
        limactl shell "$DOUBLE" sudo dd if=/dev/zero of=/dev/shm/fill bs=1M count=3500
        # Hold that memory for as long as a second VM takes to start.
        sleep 180
        ;;
    shared-stop-host)
        ensure_instance "$SHARED"
        limactl stop "$SHARED"
        ensure_instance "$HOST"
        ;;
    vz-shared-delay-host)
        ensure_instance "$SHARED"
        # The gap spans several evidence ticks, so a lost runner shows whether it died as
        # the first instance finished starting or as the second one started.
        date -u >"${HOME}/vmnet-evidence/first-vm-ready"
        sleep 120
        ensure_instance "$HOST"
        ;;
    vz-create-both-delay-host)
        # Copy the image and build the disk for both instances before either runs, so
        # starting the second one only boots its VM.
        limactl create --yes --name "$SHARED" --network=lima:shared template:default
        limactl create --yes --name "$HOST" --network=lima:host template:default
        limactl start "$SHARED" 3>&- 4>&-
        date -u >"${HOME}/vmnet-evidence/first-vm-ready"
        sleep 120
        limactl start "$HOST" 3>&- 4>&-
        ;;
    vz-plain)
        # Plain mode skips the guest agent, mounts, port forwarding and containerd.
        # The instances start one after the other, with no wait.
        limactl start --yes --name "$SHARED" --plain --network=lima:shared template:default 3>&- 4>&-
        date -u >"${HOME}/vmnet-evidence/first-vm-ready"
        limactl start --yes --name "$HOST" --plain --network=lima:host template:default 3>&- 4>&-
        ;;
    vz-plain-small)
        # Plain mode, with 1 CPU and 2 GiB per instance, the size #5717 uses.
        # The instances start one after the other, with no wait.
        limactl start --yes --name "$SHARED" --plain --cpus=1 --memory=2 --network=lima:shared template:default 3>&- 4>&-
        date -u >"${HOME}/vmnet-evidence/first-vm-ready"
        limactl start --yes --name "$HOST" --plain --cpus=1 --memory=2 --network=lima:host template:default 3>&- 4>&-
        ;;
    *)
        ensure_instance "$SHARED"
        ensure_instance "$HOST"
        ;;
    esac
}

local_teardown_file() {
    [[ -n ${DAEMON:-} ]] || return 0
    delete_instance "$SHARED"
    delete_instance "$HOST"
    delete_instance "$DOUBLE"
    delete_instance "$PLAIN1"
    delete_instance "$PLAIN2"
}

local_setup() {
    case ${NETWORK_ARM:-} in
    two-plain | bare-qemu | bare-qemu-delayed | one-double | shared-stop-host)
        skip "this arm tests only setup_file, and the tests need running shared and host instances"
        ;;
    esac
}

linux_only() {
    [[ $(uname -s) == "Linux" ]] || skip "only lima-privileged-net uses bridges, tap devices and iptables"
}

bats::on_failure() {
    tail -n 100 "${LIMA_HOME}"/_networks/*.log || :
}

guest_ip() {
    limactl shell "$1" ip -4 -j addr show dev lima0 | jq -r '.[0].addr_info[0].local'
}

@test 'each guest gets an address on its network' {
    run_e -0 guest_ip "$SHARED"
    assert_output --regexp '^192\.168\.105\.'
    run_e -0 guest_ip "$HOST"
    assert_output --regexp '^192\.168\.106\.'
}

@test 'each bridge has one tap device, owned by the user' {
    linux_only
    local bridge
    for bridge in lima-shared lima-host; do
        run -0 ls "/sys/class/net/${bridge}/brif"
        assert_output_lines_count 1
        run -0 cat "/sys/class/net/${output}/owner"
        assert_output "$(id -u)"
    done
}

@test 'the host reaches each guest' {
    ping -c 3 "$(guest_ip "$SHARED")"
    ping -c 3 "$(guest_ip "$HOST")"
}

@test 'the shared network reaches the outside world through NAT' {
    # --interface binds the device; the default route would otherwise use the user-mode network.
    limactl shell "$SHARED" curl -sSf --max-time 30 --interface lima0 -o /dev/null https://github.com
}

@test 'the host network cannot reach the shared network through the host' {
    if [[ $(uname -s) == "Linux" ]]; then
        # The ping below fails while either rule exists, so check both.
        sudo iptables -C FORWARD -i lima-host -j REJECT
        sudo iptables -C FORWARD -o lima-host -j REJECT
    fi
    local shared_ip
    shared_ip=$(guest_ip "$SHARED")
    # Without these routes the ping fails for lack of a route, whether or not the host isolates the networks.
    limactl shell "$SHARED" sudo ip route replace 192.168.106.0/24 via 192.168.105.1 dev lima0
    limactl shell "$HOST" sudo ip route replace 192.168.105.0/24 via 192.168.106.1 dev lima0
    run -1 limactl shell "$HOST" ping -c 1 -W 5 "$shared_ip"
}

@test 'the host network cannot reach the outside world through the host' {
    local ip
    ip=$(limactl shell "$HOST" getent ahostsv4 github.com | awk 'NR==1 {print $1}')
    # The host network advertises no router, so route explicitly; the running shared network has enabled ip_forward.
    limactl shell "$HOST" sudo ip route replace "${ip}/32" via 192.168.106.1 dev lima0
    run ! limactl shell "$HOST" curl -sSf --max-time 10 --interface lima0 --resolve "github.com:443:${ip}" -o /dev/null https://github.com
}

@test 'another LIMA_HOME leaves a network that is in use running' {
    linux_only
    # `limactl stop` reconciles even when the instance is missing, and this LIMA_HOME
    # is empty, so only the bridgeInUse guard keeps both networks up.
    LIMA_HOME="${BATS_TEST_TMPDIR}/other" limactl stop nonexistent || :
    assert_file_exists "${VAR_RUN}/shared_${DAEMON}.pid"
    assert_file_exists "${VAR_RUN}/host_${DAEMON}.pid"
}

@test 'stopping the last instance of a network tears only that network down' {
    limactl stop "$SHARED"
    assert_file_not_exists "${VAR_RUN}/shared_${DAEMON}.pid"
    assert_file_exists "${VAR_RUN}/host_${DAEMON}.pid"
    if [[ $(uname -s) == "Linux" ]]; then
        assert_not_exists /sys/class/net/lima-shared
        run -1 sudo iptables -t nat -C POSTROUTING -s 192.168.105.0/24 ! -d 192.168.105.0/24 -j MASQUERADE
        assert_exists /sys/class/net/lima-host
    fi

    limactl stop "$HOST"
    assert_file_not_exists "${VAR_RUN}/host_${DAEMON}.pid"
    if [[ $(uname -s) == "Linux" ]]; then
        assert_not_exists /sys/class/net/lima-host
        run -1 sudo iptables -C FORWARD -i lima-host -j REJECT
    fi
}
